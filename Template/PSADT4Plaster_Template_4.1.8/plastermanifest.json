                        "destination":  "PSADT4-${InstallTitleFileName}\\Strings\\"
                    },
                    {
                        "type":  "file",
                        "source":  "PSADT\\SupportFiles\\*",
                        "destination":  "PSADT4-${InstallTitleFileName}\\SupportFiles\\"
                    },
                    {
