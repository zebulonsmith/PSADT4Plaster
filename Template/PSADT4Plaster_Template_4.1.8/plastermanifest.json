                                           {
                                               "label":  "\u0026True",
                                               "value":  "$true",
                                               "help":  "Require admin"
                                           },
                                           {
                                               "label":  "\u0026False",
                                               "value":  "$false",
                                               "help":  "Do not require admin"
                                           }
                                       ]
