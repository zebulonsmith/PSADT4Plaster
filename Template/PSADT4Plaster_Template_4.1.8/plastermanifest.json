                           "prompt":  "Application architecture",
                           "default":  "0",
                           "store":  "text",
                           "choices":  [
                                           {
                                               "label":  "\u002664-bit",
                                               "value":  "x64",
                                               "help":  "64-bit Application"
                                           },
                                           {
                                               "label":  "\u002632-bit",
                                               "value":  "x86",
                                               "help":  "32-bit Application"
                                           }
