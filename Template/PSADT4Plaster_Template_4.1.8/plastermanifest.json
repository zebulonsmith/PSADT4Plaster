    "content":  [
                    {
                        "type":  "file",
                        "source":  "PSADT\\**\\*",
                        "destination":  "PSADT4-${InstallTitleFileName}\\"
                    },
                    {
                        "type":  "file",
                        "source":  "PSADT\\Assets\\*",
                        "destination":  "PSADT4-${InstallTitleFileName}\\Assets\\"
                    },
                    {
                        "type":  "file",
                        "source":  "PSADT\\Files\\*",
                        "destination":  "PSADT4-${InstallTitleFileName}\\Files\\"
                    },
                    {
                        "type":  "file",
                        "source":  "PSADT\\PSAppDeployToolkit\\*",
                        "destination":  "PSADT4-${InstallTitleFileName}\\PSAppDeployToolkit\\"
                    },
                    {
                        "type":  "file",
                        "source":  "PSADT\\PSAppDeployToolkit.Extensions\\*",
                        "destination":  "PSADT4-${InstallTitleFileName}\\PSAppDeployToolkit.Extensions\\"
                    },
                    {
                        "type":  "file",
